# Chi-Spark AI — backup configuration
#
# Install to /etc/chispark/backup.env
#   sudo install -D -m 600 -o root -g root backup.env.example /etc/chispark/backup.env
#
# Contains storage credentials. Must be mode 600, owned by root, and must never
# be committed to git.

# Application directory — databases are discovered under here automatically.
APP_DIR=/opt/chispark

# ---------------------------------------------------------------- destination
# Anywhere except this VPS. A backup on the same disk as the thing it protects
# is not a backup.
#
# Cloudflare R2 (no egress fees, ~$0.015/GB/month):
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/chispark-backups
#
# Backblaze B2 alternative:
# RESTIC_REPOSITORY=b2:chispark-backups:/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------ encryption
# The file holding the restic repository password (mode 600).
RESTIC_PASSWORD_FILE=/etc/chispark/restic-password
#
#   ##################################################################
#   #  STORE THIS PASSWORD SOMEWHERE OTHER THAN THIS SERVER.         #
#   #                                                                #
#   #  restic encrypts client-side. There is no recovery path and no #
#   #  support line — lose the password and every backup you have is #
#   #  permanently unreadable.                                       #
#   #                                                                #
#   #  The classic way this ends badly: the server dies, and the only #
#   #  copy of the key to the backups died with it.                  #
#   #                                                                #
#   #  Put it in a password manager the founders can all reach, and  #
#   #  on paper somewhere physical. Do it before the first run.      #
#   ##################################################################
#
# Generate one:
#   openssl rand -base64 48 | sudo tee /etc/chispark/restic-password
#   sudo chmod 600 /etc/chispark/restic-password

# ------------------------------------------------------------------- postgres
# Only if you move off SQLite. Leave unset otherwise — the script skips it.
# DATABASE_URL=postgres://user:pass@host:5432/chispark

# ------------------------------------------------------------------ retention
# Cheap, because restic deduplicates: a mostly-unchanged database costs almost
# nothing per additional snapshot. Twelve monthlies is a year of history.
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
